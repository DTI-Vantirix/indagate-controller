//! SA-16P: deterministic test of the actual patched authorization engine.
//! No controller hardware, cloud endpoint, or production SQLite file is opened.
mod access {
    pub mod schedule { include!("../access/schedule.rs"); }
    pub mod engine { include!("../access/engine.rs"); }
}
fn main() { println!("SA16P_HARDEN_OFFLINE_TEST_BIN=TEST_ONLY"); }

#[cfg(test)]
mod tests {
    use super::access::engine::{self, AccessDecision};
    use anyhow::Result;
    use chrono::{DateTime, Utc};
    use rusqlite::{params, Connection};

    fn at(value:&str) -> DateTime<Utc> { value.parse().expect("valid ISO UTC") }
    fn fixture() -> Result<Connection> {
        let db=Connection::open_in_memory()?;
        db.execute_batch(r#"
            CREATE TABLE door_config (channel INTEGER PRIMARY KEY, enabled INTEGER NOT NULL);
            CREATE TABLE credentials (id TEXT PRIMARY KEY,facility_code INTEGER NOT NULL,
                card_code INTEGER NOT NULL,enabled INTEGER NOT NULL,holder_name TEXT,
                valid_from TEXT,valid_until TEXT);
            CREATE TABLE access_levels (id TEXT PRIMARY KEY,enabled INTEGER NOT NULL);
            CREATE TABLE credential_access_levels (credential_id TEXT NOT NULL,access_level_id TEXT NOT NULL);
            CREATE TABLE access_level_doors (access_level_id TEXT NOT NULL,channel INTEGER NOT NULL,schedule_id TEXT);
            CREATE TABLE schedules (id TEXT PRIMARY KEY,timezone TEXT NOT NULL, definition_json TEXT NOT NULL);
            CREATE TABLE holidays (id TEXT PRIMARY KEY,holiday_date TEXT NOT NULL,behavior TEXT NOT NULL,schedule_id TEXT);
            INSERT INTO door_config VALUES(0,1);
            INSERT INTO credentials VALUES('card',41,1234,1,'Lab',NULL,NULL);
            INSERT INTO access_levels VALUES('A',1);
            INSERT INTO credential_access_levels VALUES('card','A');
            INSERT INTO access_level_doors VALUES('A',0,'S');
            INSERT INTO schedules VALUES('S','America/New_York','{"always":true}');
        "#)?;
        Ok(db)
    }
    fn result(db:&Connection,utc:&str) -> Result<(bool,String)> {
        let d=engine::evaluate_at(db,41,1234,0,at(utc))?;
        Ok((matches!(d.decision,AccessDecision::Grant),d.reason))
    }
    fn assert_grant(db:&Connection,utc:&str)->Result<()> {
        let (allow,reason)=result(db,utc)?;
        assert!(allow,"expected GRANT at {utc}; reason={reason}");Ok(())
    }
    fn assert_deny(db:&Connection,utc:&str,want:&str)->Result<()> {
        let (allow,reason)=result(db,utc)?;
        assert!(!allow,"expected DENY at {utc}; observed GRANT");
        assert_eq!(reason,want,"wrong denial reason at {utc}");Ok(())
    }
    fn second_level(db:&Connection,id:&str,schedule:Option<&str>)->Result<()> {
        db.execute("INSERT INTO access_levels VALUES(?1,1)",[id])?;
        db.execute("INSERT INTO credential_access_levels VALUES('card',?1)",[id])?;
        db.execute("INSERT INTO access_level_doors VALUES(?1,0,?2)",params![id,schedule])?;
        Ok(())
    }
    #[test] fn default_grant_and_unauthorized_door() -> Result<()> {
        let db=fixture()?;assert_grant(&db,"2026-11-02T15:00:00Z")?;
        db.execute("DELETE FROM access_level_doors",[])?;
        assert_deny(&db,"2026-11-02T15:00:00Z","door_not_allowed")?;Ok(())
    }
    #[test] fn unscheduled_no_holiday_legacy_grant_preserved() -> Result<()> {
        let db=fixture()?;db.execute("UPDATE access_level_doors SET schedule_id=NULL",[])?;
        assert_grant(&db,"2026-11-02T15:00:00Z")
    }
    #[test] fn unscheduled_holiday_deny_cannot_be_bypassed() -> Result<()> {
        let db=fixture()?;db.execute("UPDATE access_level_doors SET schedule_id=NULL",[])?;
        db.execute("INSERT INTO holidays VALUES('h','2026-11-02','deny',NULL)",[])?;
        assert_deny(&db,"2026-11-02T15:00:00Z","schedule_missing_for_holiday")
    }
    #[test] fn unscheduled_with_any_holiday_fails_closed_without_timezone() -> Result<()> {
        let db=fixture()?;db.execute("UPDATE access_level_doors SET schedule_id=NULL",[])?;
        db.execute("INSERT INTO holidays VALUES('h','2027-12-25','deny',NULL)",[])?;
        assert_deny(&db,"2026-11-02T15:00:00Z","schedule_missing_for_holiday")
    }
    #[test] fn holiday_deny_cannot_be_bypassed_by_another_active_level() -> Result<()> {
        let db=fixture()?;
        second_level(&db,"B",Some("S"))?;
        db.execute("INSERT INTO holidays VALUES('h','2026-11-02','deny',NULL)",[])?;
        assert_deny(&db,"2026-11-02T15:00:00Z","holiday_denied")
    }
    #[test] fn holiday_deny_in_another_timezone_vetoes_early_active_grant() -> Result<()> {
        let db=fixture()?;
        db.execute("INSERT INTO schedules VALUES('UTC','UTC','{\"always\":true}')",[])?;
        second_level(&db,"B",Some("UTC"))?;
        // 00:30 UTC on Nov 3 is still Nov 2 in New York.
        db.execute("INSERT INTO holidays VALUES('h','2026-11-02','deny',NULL)",[])?;
        assert_deny(&db,"2026-11-03T00:30:00Z","holiday_denied")
    }
    #[test] fn holiday_denial_vetoes_an_unscheduled_grant() -> Result<()> {
        let db=fixture()?;
        second_level(&db,"B",None)?;
        db.execute("INSERT INTO holidays VALUES('h','2026-11-02','deny',NULL)",[])?;
        assert_deny(&db,"2026-11-02T15:00:00Z","schedule_missing_for_holiday")
    }
    #[test] fn weekly_schedule_normal_boundaries() -> Result<()> {
        let db=fixture()?;
        db.execute("UPDATE schedules SET definition_json=?1 WHERE id='S'",[r#"{"monday":[{"start":"09:00","end":"17:00"}]}"#])?;
        assert_deny(&db,"2026-11-02T13:59:59Z","schedule_inactive")?;
        assert_grant(&db,"2026-11-02T14:00:00Z")?;
        assert_deny(&db,"2026-11-02T22:00:00Z","schedule_inactive")?;Ok(())
    }
    #[test] fn overnight_carryover_and_end_exclusive() -> Result<()> {
        let db=fixture()?;
        db.execute("UPDATE schedules SET definition_json=?1 WHERE id='S'",[r#"{"monday":[{"start":"22:00","end":"06:00"}]}"#])?;
        assert_deny(&db,"2026-11-03T02:59:59Z","schedule_inactive")?;
        assert_grant(&db,"2026-11-03T03:00:00Z")?;
        assert_grant(&db,"2026-11-03T10:59:59Z")?;
        assert_deny(&db,"2026-11-03T11:00:00Z","schedule_inactive")?;Ok(())
    }
    #[test] fn utc_to_iana_fall_fold_evaluated_consistently() -> Result<()> {
        let db=fixture()?;
        db.execute("UPDATE schedules SET definition_json=?1 WHERE id='S'",[r#"{"sunday":[{"start":"01:00","end":"01:30"}]}"#])?;
        assert_grant(&db,"2026-11-01T05:15:00Z")?;
        assert_grant(&db,"2026-11-01T06:15:00Z")?;
        assert_deny(&db,"2026-11-01T07:15:00Z","schedule_inactive")?;Ok(())
    }
    #[test] fn utc_to_iana_spring_gap_skips_missing_local_hour() -> Result<()> {
        let db=fixture()?;
        db.execute("UPDATE schedules SET definition_json=?1 WHERE id='S'",[r#"{"sunday":[{"start":"02:00","end":"03:30"}]}"#])?;
        assert_deny(&db,"2027-03-14T06:59:59Z","schedule_inactive")?;
        assert_grant(&db,"2027-03-14T07:00:00Z")?;
        assert_deny(&db,"2027-03-14T07:30:00Z","schedule_inactive")?;Ok(())
    }
    #[test] fn credential_validity_inclusive_start_exclusive_end() -> Result<()> {
        let db=fixture()?;
        db.execute("UPDATE credentials SET valid_from='2026-11-02T14:00:00Z',valid_until='2026-11-02T15:00:00Z'",[])?;
        assert_deny(&db,"2026-11-02T13:59:59Z","credential_not_yet_valid")?;
        assert_grant(&db,"2026-11-02T14:00:00Z")?;
        assert_deny(&db,"2026-11-02T15:00:00Z","credential_expired")?;Ok(())
    }
    #[test] fn holiday_override_only_allows_during_alternate_schedule() -> Result<()> {
        let db=fixture()?;
        db.execute("INSERT INTO schedules VALUES('override','America/New_York',?1)",[r#"{"monday":[{"start":"11:00","end":"12:00"}]}"#])?;
        db.execute("INSERT INTO holidays VALUES('h','2026-11-02','use_schedule','override')",[])?;
        assert_deny(&db,"2026-11-02T15:59:59Z","schedule_inactive")?;
        assert_grant(&db,"2026-11-02T16:00:00Z")?;
        assert_deny(&db,"2026-11-02T17:00:00Z","schedule_inactive")?;Ok(())
    }
}

#[cfg(test)]
mod extra_order_tests {
    use super::access::engine::{self, AccessDecision};
    use anyhow::Result;
    use rusqlite::Connection;
    #[test]
    fn an_earlier_utc_grant_does_not_hide_later_new_york_holiday_deny() -> Result<()> {
        let db=Connection::open_in_memory()?;
        db.execute_batch(r#"
            CREATE TABLE door_config(channel INTEGER PRIMARY KEY,enabled INTEGER NOT NULL);
            CREATE TABLE credentials(id TEXT PRIMARY KEY,facility_code INTEGER NOT NULL,card_code INTEGER NOT NULL,enabled INTEGER NOT NULL,holder_name TEXT,valid_from TEXT,valid_until TEXT);
            CREATE TABLE access_levels(id TEXT PRIMARY KEY,enabled INTEGER NOT NULL);
            CREATE TABLE credential_access_levels(credential_id TEXT,access_level_id TEXT);
            CREATE TABLE access_level_doors(access_level_id TEXT,channel INTEGER,schedule_id TEXT);
            CREATE TABLE schedules(id TEXT PRIMARY KEY,timezone TEXT NOT NULL,definition_json TEXT NOT NULL);
            CREATE TABLE holidays(id TEXT PRIMARY KEY,holiday_date TEXT,behavior TEXT,schedule_id TEXT);
            INSERT INTO door_config VALUES(0,1);
            INSERT INTO credentials VALUES('card',41,1234,1,'Bench',NULL,NULL);
            INSERT INTO access_levels VALUES('A',1);
            INSERT INTO access_levels VALUES('B',1);
            INSERT INTO credential_access_levels VALUES('card','A');
            INSERT INTO credential_access_levels VALUES('card','B');
            INSERT INTO access_level_doors VALUES('A',0,'UTC');
            INSERT INTO access_level_doors VALUES('B',0,'NY');
            INSERT INTO schedules VALUES('UTC','UTC','{"always":true}');
            INSERT INTO schedules VALUES('NY','America/New_York','{"always":true}');
            INSERT INTO holidays VALUES('h','2026-11-02','deny',NULL);
        "#)?;
        let at="2026-11-03T00:30:00Z".parse()?;
        let result=engine::evaluate_at(&db,41,1234,0,at)?;
        assert!(matches!(result.decision,AccessDecision::Deny));
        assert_eq!(result.reason,"holiday_denied");
        Ok(())
    }
}
