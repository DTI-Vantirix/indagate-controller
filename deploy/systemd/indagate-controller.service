# The door controller. The server address and its certificate are set in a drop-in:
#   /etc/systemd/system/indagate-controller.service.d/*.conf
#     [Service]
#     Environment=INDAGATE_SERVER_URL=https://<server>:<port>
#     Environment=INDAGATE_SERVER_CA_FILE=/etc/indagate/<certificate>.crt
[Unit]
Description=Indagate door controller
Wants=network-online.target indagate-board-power.service
After=network-online.target indagate-board-power.service
# monitor.service is the board maker's own application; the two must never run together.
Conflicts=monitor.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=root
WorkingDirectory=/var/lib/indagate
ExecStart=/opt/indagate/current/indagate-controller
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
